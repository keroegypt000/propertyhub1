generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// === USER HIERARCHY ===
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  passwordHash String
  salt         String
  role         String    @default("viewer") // admin, manager, accountant, collector, viewer
  permissions  String?   // JSON: granular permissions per entity
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  uploads       FileUpload[]
  restorePoints RestorePoint[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === PROPERTY MANAGEMENT ===
model Building {
  id          String   @id @default(cuid())
  code        String   @unique  // كود العمارة
  name        String
  address     String?
  city        String?
  floors      Int?
  unitsCount  Int?
  value       Float?   @default(0) // القيمة الدفترية
  license     String?  // رقم الترخيص / السجل العقاري
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]
  transactions Transaction[]
  maintenanceRequests MaintenanceRequest[]
  uploads     FileUpload[]
  legalCases  LegalCase[]
}

model Unit {
  id          String   @id @default(cuid())
  buildingId  String
  number      String
  floor       Int?
  area        Float?
  type        String?  // apartment, office, shop, warehouse
  status      String   @default("available") // available, rented, maintenance, reserved
  rentAmount  Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contracts   Contract[]
  maintenanceRequests MaintenanceRequest[]
  legalCases  LegalCase[]
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  tenantType      String   @default("individual") // individual (فرد/عائلة) | company (شركة)
  commercialReg   String?  // رقم السجل التجاري (للشركات)
  phone           String?
  email           String?
  idNumber        String?  // الرقم القومي (14 رقم)
  idType          String?  // national, passport, commercial
  address         String?
  emergencyContact String?
  guarantor       String?  // اسم الضامن
  guarantorPhone  String?  // هاتف الضامن
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contracts     Contract[]
  uploads       FileUpload[]
  legalCases    LegalCase[]
}

model Contract {
  id           String   @id @default(cuid())
  unitId       String
  tenantId     String
  startDate    DateTime
  endDate      DateTime
  rentAmount   Float
  discount     Float?   @default(0) // الخصم الشهري — الإيجار الفعلي = rentAmount - discount
  deposit      Float?   @default(0) // مبلغ التأمين
  paymentDay   Int?     // day of month for payment
  status       String   @default("active") // active, expired, terminated, renewed, vacated
  vacatedDate  String?  // تاريخ الإخلاء
  refund       Float?   // المبلغ المردود من التأمين
  terms        String?
  notes        String?
  rentHistory  String?  // JSON: [{from, rent}] تاريخ تغيير الإيجار
  renewHistory String?  // JSON: [{on, oldEnd, newEnd, rent}] تاريخ التجديد
  number       String?  @unique // الرقم التسلسلي للعقد (ع-0001) — يُسند آليًا عند الإنشاء ولا يُقبل من المستخدم
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments     Payment[]
  attachments  FileUpload[]
}

model Payment {
  id          String   @id @default(cuid())
  contractId  String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  month       String?  // الشهر الذي يخصه الدفع (YYYY-MM)
  status      String   @default("pending") // pending, paid, partial, overdue, cancelled
  method      String?  // cash, transfer, check, card
  reference   String?  // receipt/check number
  notes       String?
  invoiceNo   String?  @unique // رقم فاتورة الإيجار التسلسلي (ف-0001) — يُسند آليًا عند إنشاء الدفعة
  receiptNo   String?  @unique // رقم سند القبض التسلسلي (ق-0001) — يُسند آليًا عند التحصيل (مدفوع/جزئي)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// === TRANSACTIONS (Income/Expense) ===
model Transaction {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  buildingId  String?
  type        String   // income, expense
  category    String   // البيان
  amount      Float
  account     String?  // رقم الحساب من شجرة الحسابات (كود الحساب المدين/الدائن)
  cashAccount String?  // الدفع من / الاستلام في: cash | bank | checks
  voucherNo   String?  @unique // رقم السند التسلسلي (ق-0001 للإيراد / ص-0001 للمصروف) — يُسند آليًا
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building    Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
}

// === LEGAL CASES & MUNICIPAL VIOLATIONS ===
// المخالفات البلدية والقضايا القانونية المرتبطة بعمارة أو وحدة أو مستأجر
model LegalCase {
  id          String   @id @default(cuid())
  title       String   // عنوان المخالفة / القضية
  type        String   @default("municipal") // municipal (مخالفة بلدية) | lawsuit (قضية) | other (أخرى)
  reference   String?  // رقم المخالفة / رقم القضية
  buildingId  String?
  unitId      String?
  tenantId    String?
  status      String   @default("open") // open, in_progress, paid, closed
  filedDate   String?  // تاريخ المخالفة / رفع القضية (YYYY-MM-DD)
  hearingDate String?  // موعد الجلسة القادمة (YYYY-MM-DD)
  amount      Float?   // قيمة الغرامة / مبلغ القضية
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building    Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  attachments FileUpload[]
}

// === LOANS ===
model Loan {
  id          String   @id @default(cuid())
  name        String   // اسم القرض / الجهة
  buildingId  String?  // العمارة (اختياري)
  principal   Float    // مبلغ القرض
  date        String   // تاريخ الحصول
  rate        Float    @default(0) // الفائدة السنوية %
  months      Int      @default(0) // المدة بالأشهر
  receiptNo   String?  @unique // رقم سند استلام القرض التسلسلي (ق-0001) — يُسند آليًا
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    LoanPayment[]
}

model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  date        String   // تاريخ السداد
  principal   Float    // الأصل المسدد
  interest    Float    @default(0) // الفائدة المسددة
  notes       String?
  paymentNo   String?  @unique // رقم سند صرف القسط التسلسلي (ص-0001) — يُسند آليًا
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// === CHART OF ACCOUNTS ===
model Account {
  id       String  @id @default(cuid())
  code     String  @unique // رقم الحساب
  name     String  // اسم الحساب
  type     String  // asset, liability, equity, revenue, expense
  kind     String  // post (فرعي), group (رئيسي/تجميعي)
  parent   String? // الحساب الأب
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === JOURNAL ENTRIES ===
// source: manual (يدوي) | payment (تحصيل إيجار) | maintenance (مصروف صيانة) | loan (استلام قرض) | loanPayment (سداد قرض) | transaction (حركة إيراد/مصروف) | legalCase (غرامة مخالفة/قضية)
// sourceId: معرّف العملية الأصلية التي وُلّد منها القيد — يُستخدم للتحديث/الحذف التلقائي
model JournalEntry {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  description String   // البيان
  buildingId  String?
  lines       String   // JSON: [{accountId, accountCode, accountName, debit, credit}]
  source      String   @default("manual")
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, sourceId])
}

// === MAINTENANCE ===
// الصيانة إما لوحدة محددة أو للعمارة بكاملها (buildingId فقط بدون unitId)
model MaintenanceRequest {
  id          String   @id @default(cuid())
  unitId      String?
  buildingId  String?  // العمارة — يُملأ تلقائياً من الوحدة أو يُختار للصيانة العامة
  title       String
  description String?
  category    String?  // plumbing, electrical, ac, elevator, civil, cleaning, other
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("open") // open, in_progress, completed, cancelled
  estimatedCost Float?  // التكلفة التقديرية
  cost        Float?   // التكلفة الفعلية
  paymentNo   String?  @unique // رقم سند صرف تكلفة الصيانة التسلسلي (ص-0001) — يُسند آليًا عند الإكمال بتكلفة
  assignedTo  String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  attachments FileUpload[]
}

// === FILE STORAGE ===
// الملفات تُخزن في تخزين سحابي (Cloudflare R2) وعلى الميتاداتا والمرجع فقط في قاعدة البيانات
// storageProvider: "db" للملفات القديمة (محتوى داخل الحقل data) أو "r2" للسحابي
model FileUpload {
  id             String   @id @default(cuid())
  filename       String
  originalName   String
  mimeType       String
  size           Int
  data           Bytes?   // legacy: محتوى الملفات المرفوعة قبل التحول للتخزين السحابي
  storageProvider String  @default("db")   // db | r2
  storageKey     String?  // مفتاح الكائن في التخزين السحابي (بدون رابط عام دائم)
  category       String   @default("general") // contract, maintenance, identity, building_legal, legal_case, general
  docType        String?  // نوع المستند القانوني: property_deed (وثيقة عقار) | license (ترخيص) | occupancy (شهادة إشغال) | blueprint (مخطط) | other
  contractId     String?
  maintenanceId  String?
  tenantId       String?
  buildingId     String?  // مستندات العمارة القانونية (وثيقة العقار وغيرها)
  legalCaseId    String?  // مستندات المخالفات والقضايا
  uploadedBy     String?
  createdAt      DateTime @default(now())

  contract       Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  maintenance    MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  tenant         Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  building       Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  legalCase      LegalCase?          @relation(fields: [legalCaseId], references: [id], onDelete: SetNull)
  uploader      User?                @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
}

// === AUDIT TRAIL ===
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // create, update, delete, login, logout, restore, upload
  entity     String   // building, unit, tenant, contract, payment, maintenance, user, file, restore_point
  entityId   String?
  changes    String?  // JSON string of before/after values
  details    String?  // human-readable description
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === RESTORE POINTS ===
model RestorePoint {
  id          String   @id @default(cuid())
  name        String
  description String?
  snapshot    String   // JSON string of full database state
  createdBy   String
  createdAt   DateTime @default(now())

  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

// === SUPPLIERS & CONTRACTORS (موردين ومقاولين) ===
model Supplier {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("contractor") // contractor مقاول / supplier مورد
  phone       String?
  specialty   String?  // التخصص — سباكة/كهرباء/مصاعد/تشطيبات...
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    SupplierPayment[]
}

model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String
  date        String   // YYYY-MM-DD
  amount      Float
  description String?  // بيان الدفعة — على أي شغلانة
  buildingId  String?  // العمارة المرتبطة (اختياري)
  method      String   @default("cash") // cash, transfer, check, card
  accountCode String   @default("5206") // حساب المصروف من شجرة الحسابات
  paymentNo   String?  @unique // رقم سند الصرف التسلسلي (ص-0001) — يُسند آليًا
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// === عدّاد الترقيم التسلسلي للمستندات ===
// سطر واحد لكل تسلسل: contract (عقود) | invoice (فواتير إيجار) | receipt (سندات قبض) | payment (سندات صرف)
// يتزايد ذريًا عبر upsert داخل معاملة الإنشاء — لا فجوات عشوائية ولا أرقام مكررة
model DocCounter {
  key     String @id // contract | invoice | receipt | payment
  current Int    @default(0)
}
